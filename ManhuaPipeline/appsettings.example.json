{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicBaseUrl": "https://mangaengine.cn",
  "Stage5": {
    "MaxConcurrency": 5,
    "StoryboardMaxConcurrency": 4
  },
  "AssetImageQueue": {
    "MaxConcurrency": 3
  },
