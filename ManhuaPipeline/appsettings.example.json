      "Temperature": 0.2
    },
    "SemanticValidation": {
      "Enabled": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ManhuaPipeline;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;"
  },
  "Urls": "http://0.0.0.0:5133"
}
